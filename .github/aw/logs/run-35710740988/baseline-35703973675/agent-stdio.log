{"type":"tool_use","timestamp":"2026-09-22T08:19:16.715Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_518966","parameters":{"description":"Check releases for active packages","command":"python3 -c '\nimport json, subprocess\n\nwith open(\"packages/registry.json\") as f:\n    registry = json.load(f)\n\nfor entry in registry:\n    if not entry.get(\"active\", True):\n        continue\n    pkg = entry[\"pkg\"]\n    upstream = entry[\"upstream\"]\n    allow_prerelease = entry.get(\"allow_prerelease\", False)\n    \n    # 1. Get latest release\n    cmd = [\"gh\", \"release\", \"list\", \"-R\", upstream, \"--limit\", \"5\"]\n    res = subprocess.run(cmd, capture_output=True, text=True)\n    print(f\"=== {pkg} ({upstream}) ===\")\n    print(\"Release list stdout:\", res.stdout)\n    print(\"Release list stderr:\", res.stderr)\n'"}}
